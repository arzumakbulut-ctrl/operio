# ─── VERİTABANI ───────────────────────────────────────────
DATABASE_URL="postgresql://operio:operio_secret@localhost:5432/operio_db"

# ─── JWT ───────────────────────────────────────────────────
# Üretimde güçlü rastgele değerler kullanın (openssl rand -hex 64)
JWT_ACCESS_SECRET="operio-access-secret-degistir"
JWT_REFRESH_SECRET="operio-refresh-secret-degistir"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── KIOSK ─────────────────────────────────────────────────
# Ameliyathane kiosk cihazları için ayrı, uzun ömürlü imzalama anahtarı
# Üretimde güçlü rastgele bir değer kullanın (openssl rand -hex 64)
KIOSK_JWT_SECRET="operio-kiosk-secret-degistir"

# ─── SPOTIFY ───────────────────────────────────────────────
# Klinisyenin kendi Spotify hesabını Profil sayfasından bağlaması için OAuth
# kimlik bilgileri (https://developer.spotify.com/dashboard)
SPOTIFY_CLIENT_ID="spotify-client-id-degistir"
SPOTIFY_CLIENT_SECRET="spotify-client-secret-degistir"
SPOTIFY_REDIRECT_URI="http://localhost:4000/api/spotify/callback"
# OAuth state parametresini imzalamak için ayrı, kısa ömürlü anahtar
# (JWT_ACCESS_SECRET'tan farklı — sadece redirect round-trip'i için)
SPOTIFY_STATE_SECRET="operio-spotify-state-secret-degistir"

# ─── SPEAKER-ID ────────────────────────────────────────────
# Kiosk konuşmacı-tanıma mikroservisi (speaker-id-service/, docker-compose'daki
# "speaker-id" servisi) — sadece iç ağda erişilir, dışa port açılmaz.
SPEAKER_ID_SERVICE_URL="http://speaker-id:8001"
# getEmbedding'in bu servise verdiği HTTP çağrısı için üst sınır (ms). Servis
# takılırsa (CPU-bound model yükü vb.) kiosk sesli asistanının TAMAMI bu süre
# kadar beklemiş olur — bkz. speakerIdClient.js dosya başı yorumu.
SPEAKER_ID_TIMEOUT_MS=3000

# ─── TASARIMCI KARŞILAMASI (easter-egg) ─────────────────────
# Tasarımcının sesi gerçek Speaker-ID ile tanınınca (SADECE kiosk_mock_config.
# mode='real' olan kurumlarda) komut akışına girmeden sabit bir karşılama
# döner — bkz. docs/superpowers/specs/2026-11-24-operio-voice-designer-
# greeting-design.md. Boşsa özellik tamamen devre dışıdır.
# scripts/provision-designer-account.js'in bastığı id buraya yazılır.
DESIGNER_USER_ID=

# ─── UYGULAMA ──────────────────────────────────────────────
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:5173"

# ─── RATE LIMITING ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=10

# ─── CLAUDE AI ─────────────────────────────────────────────────
ANTHROPIC_API_KEY="sk-ant-..."
AI_MODEL="claude-sonnet-4-20250514"
AI_MAX_TOKENS=1024

# ─── SOCKET.IO ─────────────────────────────────────────────────
# CORS_ORIGIN zaten tanımlı — Socket.io aynı origin'i kullanır
# Ayrıca bir şey gerekmez.

# ─── ÖDEME SİSTEMLERİ ──────────────────────────────────────────
# İyzico (Türkiye)
IYZICO_API_KEY="sandbox-..."
IYZICO_SECRET_KEY="sandbox-..."
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# Stripe (Uluslararası)
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."
STRIPE_PRICE_STARTER="price_..."
STRIPE_PRICE_PRO="price_..."

# Genel
PAYMENT_SUCCESS_URL="http://localhost:5173/odeme/basarili"
PAYMENT_FAIL_URL="http://localhost:5173/odeme/basarisiz"
APP_BASE_URL="http://localhost:4000"
